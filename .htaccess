AddDefaultCharset UTF-8
RewriteEngine On

# Rutas locales relativas a la carpeta del proyecto. No dependen de /ikusa.
RewriteRule ^$ public_html/index.php?lang=es&page=home [L,QSA]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^(es|en|eu)/?$ public_html/index.php?lang=$1&page=home [L,QSA]
RewriteRule ^es/(desarrollo-web|diseno-grafico|marketing-digital)/?$ public_html/index.php?lang=es&page=services&action=$1 [L,QSA]
RewriteRule ^es/contacto/?$ public_html/index.php?lang=es&page=contact&action=create [L,QSA]
RewriteRule ^es/nosotros/?$ public_html/index.php?lang=es&page=about [L,QSA]
RewriteRule ^es/tarjetas-de-visitas/?$ public_html/index.php?lang=es&page=cards [L,QSA]
RewriteRule ^es/gracias/?$ public_html/index.php?lang=es&page=contact&action=success [L,QSA]
RewriteRule ^es/legal/(aviso-legal|politica-de-cookies|politica-de-proteccion-de-datos|terminos-y-condiciones)/?$ public_html/index.php?lang=es&page=legal/$1 [L,QSA]
RewriteRule ^es/legal/propuesta-de-branding/?$ public_html/index.php?lang=es&page=branding-proposal [L,QSA]
RewriteRule ^es/legal/condiciones-para-sitio-web/?$ public_html/index.php?lang=es&page=website-terms [L,QSA]
RewriteRule ^(es|en|eu)/proyectos/([a-z0-9-]+)/?$ public_html/index.php?lang=$1&page=$2 [L,QSA]
RewriteRule ^(es|en|eu)/([a-z0-9-]+)/?$ public_html/index.php?lang=$1&page=$2 [L,QSA]
