 $dir = $_SERVER['DOCUMENT_ROOT'] . "/assets/img/portfolio/merchandising";
$direc = @opendir($dir) or die("permiso denegado");
while ($file = readdir($direc)) {
    if ($file != "." && $file != ".." && $file != ".DS_Store") {
        $filename = pathinfo($file, PATHINFO_FILENAME);
        $absoluteRoute = $_SERVER['DOCUMENT_ROOT'] . "/assets/img/portfolio/merchandising/" . $file;
        $srcRoute = "/assets/img/portfolio/merchandising/" . $file;

        list($width, $height) = getimagesize($absoluteRoute);

        $aspect_ratio = '';
        if ($width >= 500 && $width <= 700) {
            $aspect_ratio = "medium-wide";
        } elseif ($width / $height >= 5) {
            $aspect_ratio = "widescreen";
        } elseif ($width / $height >= 2.5) {
            $aspect_ratio = "wide-landscape";
        } elseif ($width > $height) {
            $aspect_ratio = "landscape";
        } elseif ($width < $height) {
            $aspect_ratio = "portrait";
        } else {
            $aspect_ratio = "square";
        }

        echo '<a class="grid-gallery__item" href="#" data-aspect-ratio="' . $aspect_ratio . '">';
        echo "<img src='" . $srcRoute . "' alt='" . $filename . "' title='" . $filename . "' class='grid-gallery__image' />";
        echo '</a>';
    }
}
closedir($direc);
    ?>
